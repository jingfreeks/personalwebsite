# Contact form (POST /api/contact) — sends email through Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxx
# Where messages are delivered (defaults to the email in lib/site.ts)
CONTACT_TO_EMAIL=lyndell.dobluis@gmail.com
# Sender. "onboarding@resend.dev" works without a verified domain but can only
# deliver to the Resend account owner's address; verify a domain to use your own.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
